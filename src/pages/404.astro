---
import { link } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import knife from '../assets/bread-board.jpg';
---

<Base title="Page not found">
  <PageHero eyebrow="Error 404" image={knife}>
    <Fragment slot="title">Nothing but <em>crumbs.</em></Fragment>
    That page has left the table. Let’s get you back to dinner.
    <div class="btn-row" style="margin-top:2rem;justify-content:center">
      <a class="btn btn--solid" href={link('/')}>Back home</a>
      <a class="btn" href={link('/menu/')}>See the menus</a>
    </div>
  </PageHero>
</Base>
