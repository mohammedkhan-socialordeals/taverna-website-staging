---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import ReserveBand from '../components/ReserveBand.astro';
import Hours from '../components/Hours.astro';
import { site, link } from '../data/site';
import { signatures, menu } from '../data/menu';

import steak from '../assets/steak.jpg';
import oprah from '../assets/oprah-at-taverna.jpg';
import Gallery from '../components/Gallery.astro';
import roomWide from '../assets/room/banquet-tables-wide-view.jpg';
import roomLong from '../assets/room/long-table-centre-view.jpg';
import roomFloral from '../assets/room/floral-table-setting.jpg';
import roomSide from '../assets/room/banquet-table-side-view.jpg';
import roomRed from '../assets/room/group-tables-and-wide-centre-aisle.jpg';
import roomCandle from '../assets/room/candlelit-table-with-flowers.jpg';
import roomDetail from '../assets/room/floral-table-detail.jpg';

const roomPhotos = [
  { src: roomLong, alt: 'A long table set with white linen, wine and flowers under an iron chandelier', caption: 'The long table' },
  { src: roomRed, alt: 'The red dining room with framed photographs along the wall', caption: 'The red room' },
  { src: roomFloral, alt: 'Tufted leather booths against a blue wall, tables dressed with flowers and wine', caption: 'Leather booths' },
  { src: roomSide, alt: 'Tables set for a party with the bar and the street windows behind', caption: 'Looking to 21st Street' },
  { src: roomCandle, alt: 'A candlelit table with blush linen, flowers and wine glasses', caption: 'By candlelight' },
  { src: roomDetail, alt: 'A table laid with striped napkins, red wine and fresh flowers', caption: 'Set for the evening' },
];

const ticker = [
  'Tableside Caesar',
  'Bistecca alla Fiorentina',
  'Dover Sole Piccata',
  'Spicy Rigatoni Vodka',
  'Veal Parmesan',
  'Ice-cold Martinis',
  'Whole Branzino',
  'Lasagna al Forno',
];

const bar = menu.find((g) => g.id === 'cocktails')!.sections.slice(0, 2).flatMap((s) => s.items).slice(0, 6);

const yearsOpen = new Date().getFullYear() - site.since;
---

<Base>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <Image
      class="hero__img"
      src={roomWide}
      alt="The Taverna dining room: white-linen tables, tufted leather booths and iron chandeliers under a wood ceiling"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__inner">
      <p class="hero__eyebrow">Italian Kitchen <span>✦</span> Steaks <span>✦</span> Bar</p>
      <Wordmark size="lg" tag="h1" />
      <p class="hero__tag">Steaks, pasta &amp; <em>a little theatre.</em></p>
      <div class="btn-row hero__cta">
        <a class="btn btn--solid" href={site.links.reserve} target="_blank" rel="noopener">Reserve a table</a>
        <a class="btn" href={link('/menu/')}>View the menus</a>
      </div>
    </div>
    <ul class="hero__strip">
      <li><span>Tonight</span> Dinner from 4 pm</li>
      <li><span>Find us</span> <a href={site.links.maps} target="_blank" rel="noopener">{site.address.street}, downtown Saskatoon</a></li>
      <li><span>Call</span> <a href={site.phoneHref}>{site.phone}</a></li>
    </ul>
  </section>

  <!-- ═══ TICKER ═══ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[...ticker, ...ticker].map((t) => <span>{t}<i>✦</i></span>)}
    </div>
  </div>

  <!-- ═══ HERITAGE ═══ -->
  <section class="section section--cream heritage">
    <div class="wrap heritage__grid">
      <div class="heritage__year" data-reveal aria-hidden="true">
        <span class="heritage__num">19<br />69</span>
        <span class="script heritage__script">since</span>
      </div>
      <div class="heritage__copy" data-reveal style="--i:1">
        <p class="eyebrow">Our story</p>
        <h2 class="display">{yearsOpen} years on <em>21st Street.</em></h2>
        <p class="lede">
          Taverna opened its doors in downtown Saskatoon in 1969, and the town has been coming back ever since: first
          dates, anniversaries, deals closed over veal and red wine, Sunday pizza with the kids.
        </p>
        <p>
          We’re Italian-American and proud of it. Red sauce and white tablecloths, steaks and chops, pasta made in
          house, a proper martini. The kind of dinner where somebody looks after you.
        </p>
        <a class="link" href={link('/story/')}>Read our story</a>
      </div>
      <figure class="heritage__photo" data-reveal style="--i:2">
        <Image src={roomFloral} alt="Tufted leather booths and white-linen tables set with flowers and wine" widths={[500, 900, 1400]} sizes="(max-width: 62rem) 90vw, 34vw" />
      </figure>
    </div>
  </section>

  <!-- ═══ THE ROOM ═══ -->
  <section class="section room">
    <div class="wrap room__head" data-reveal>
      <div>
        <p class="eyebrow">The room</p>
        <h2 class="display">White linen, <em>low light.</em></h2>
      </div>
      <p class="lede">
        Tufted leather booths, iron chandeliers and a wood ceiling that has seen a few celebrations. Pull up a chair.
      </p>
    </div>
    <div data-reveal><Gallery photos={roomPhotos} /></div>
  </section>

  <!-- ═══ THE THEATRE ═══ -->
  <section class="section theatre">
    <div class="wrap">
      <header class="center theatre__head" data-reveal>
        <p class="eyebrow eyebrow--center">The service</p>
        <h2 class="display">Dinner <em>and a show.</em></h2>
        <p class="lede">
          White shirts, bow ties and a cart rolling up to your table. The old-school Italian steakhouse, the way it used
          to be done.
        </p>
      </header>

      <ol class="acts">
        <li class="act" data-reveal style="--i:0">
          <span class="act__no">Act I</span>
          <svg viewBox="0 0 120 120" class="act__art" aria-hidden="true">
            <path d="M18 62h84c0 24-18 40-42 40S18 86 18 62Z" />
            <path d="M12 62h96M44 102h32" />
            <path d="M40 50c4-10 12-8 14 0M58 46c5-12 15-9 16 2M76 52c3-8 10-7 12 0" />
            <path d="M84 20 66 58M92 18c6 6 2 16-8 20" />
          </svg>
          <h3 class="act__title">The Caesar</h3>
          <p>Romaine, pancetta, focaccia croutons and grana padano, tossed and dressed in front of you.</p>
        </li>
        <li class="act" data-reveal style="--i:1">
          <span class="act__no">Act II</span>
          <svg viewBox="0 0 120 120" class="act__art" aria-hidden="true">
            <path d="M14 60c16-22 44-28 68-12l22-14-6 26 6 26-22-14c-24 16-52 10-68-12Z" />
            <circle cx="32" cy="56" r="2.5" />
            <path d="M48 46c6 8 6 20 0 28M62 44c6 10 6 22 0 32M76 48c4 8 4 16 0 24" />
          </svg>
          <h3 class="act__title">The Fish</h3>
          <p>Whole branzino and Dover sole piccata, de-boned at the table with brown butter, lemon and capers.</p>
        </li>
        <li class="act" data-reveal style="--i:2">
          <span class="act__no">Act III</span>
          <svg viewBox="0 0 120 120" class="act__art" aria-hidden="true">
            <path d="M24 38c14-16 48-18 66-4 14 12 12 34-4 46-10 8-18 6-26 12-10 8-24 6-32-6-10-16-12-36-4-48Z" />
            <path d="M52 40c-4 10-2 18 6 22 8 4 16 2 22 8M52 40c6-4 14-2 16 4" />
            <path d="M34 54c2 10 6 18 12 24" />
          </svg>
          <h3 class="act__title">The Fiorentina</h3>
          <p>Thirty-two ounces of prime porterhouse with rosemary and olive oil, carved and shared between two.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ SIGNATURES ═══ -->
  <section class="section section--ink2 sig">
    <div class="wrap sig__grid">
      <figure class="sig__photo" data-reveal>
        <Image src={steak} alt="A grilled porterhouse steak with rosemary, sea salt and peppercorns" widths={[600, 1000, 1600]} sizes="(max-width: 62rem) 100vw, 45vw" />
      </figure>
      <div class="sig__list" data-reveal style="--i:1">
        <p class="eyebrow">From the kitchen</p>
        <h2 class="display">The <em>classics.</em></h2>
        <div class="sig__dishes">
          {
            signatures.map((d) => (
              <div class="dish">
                <span class="dish__name">{d.name}</span>
                <span class="dish__price">{d.price}</span>
                <p class="dish__desc">{d.desc}</p>
              </div>
            ))
          }
        </div>
        <div class="btn-row">
          <a class="btn" href={link('/menu/')}>See the full menu</a>
          <a class="btn" href={site.links.order} target="_blank" rel="noopener">Order takeout</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ BAR ═══ -->
  <section class="section section--oxblood bar">
    <div class="wrap bar__grid">
      <div class="bar__intro" data-reveal>
        <svg viewBox="0 0 120 160" class="bar__glass" aria-hidden="true">
          <path d="M14 18h92L60 78Z" />
          <path d="M60 78v58M34 140h52" />
          <path d="M28 36h64" />
          <circle cx="70" cy="46" r="6" />
          <path d="M70 46 94 6" />
        </svg>
        <p class="eyebrow">At the bar</p>
        <h2 class="display">Stirred, <em>very cold.</em></h2>
        <p class="lede">
          Martinis and Negronis done properly, spritzes for the patio months, and an all-Italian wine list that runs
          from Tuesday-night Chianti to Sassicaia.
        </p>
        <a class="link" href={link('/menu/#cocktails')}>Cocktails &amp; wine</a>
      </div>
      <div class="bar__card frame" data-reveal style="--i:1">
        {
          bar.map((d) => (
            <div class="dish">
              <span class="dish__name">{d.name}</span>
              <span class="dish__price">{d.price}</span>
              <p class="dish__desc">{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ OPRAH ═══ -->
  <section class="section section--cream press">
    <div class="wrap press__grid">
      <figure class="press__photo" data-reveal>
        <Image src={oprah} alt="Oprah Winfrey and her party at a table at Taverna, from her Instagram post" width={400} />
      </figure>
      <blockquote class="press__quote" data-reveal style="--i:1">
        <p class="eyebrow">The night Oprah came for dinner</p>
        <p class="press__words">“Having our best meal at Taverna in Saskatoon.”</p>
        <footer>
          <cite>Oprah Winfrey</cite>
          <span>A party of twenty. They stayed three hours.</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ═══ FOUR DOORS ═══ -->
  <section class="section doors">
    <div class="wrap">
      <header class="center" data-reveal>
        <p class="eyebrow eyebrow--center">However you like it</p>
        <h2 class="title">Four ways to <em>Taverna.</em></h2>
      </header>
      <div class="doors__grid">
        <a class="door" href={site.links.reserve} target="_blank" rel="noopener" data-reveal style="--i:0">
          <span class="door__no">01</span>
          <h3>Reserve</h3>
          <p>Book your table on OpenTable in under a minute.</p>
          <span class="door__go">Book now</span>
        </a>
        <a class="door" href={site.links.order} target="_blank" rel="noopener" data-reveal style="--i:1">
          <span class="door__no">02</span>
          <h3>Takeout</h3>
          <p>Pizza, lasagna and the rest of the family favourites, ordered direct.</p>
          <span class="door__go">Order online</span>
        </a>
        <a class="door" href={link('/private-dining/')} data-reveal style="--i:2">
          <span class="door__no">03</span>
          <h3>Private Dining</h3>
          <p>Birthdays, rehearsal dinners, the company night out.</p>
          <span class="door__go">Enquire</span>
        </a>
        <a class="door" href={link('/gift-cards/')} data-reveal style="--i:3">
          <span class="door__no">04</span>
          <h3>Gift Cards</h3>
          <p>Give somebody a very good night. Delivered by email.</p>
          <span class="door__go">Send one</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ VISIT ═══ -->
  <section class="section section--ink2 visit">
    <div class="wrap visit__grid">
      <div data-reveal>
        <p class="eyebrow">Visit</p>
        <h2 class="display">Downtown, <em>since day one.</em></h2>
        <address class="visit__addr">
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postal}
        </address>
        <div class="btn-row">
          <a class="btn" href={site.links.maps} target="_blank" rel="noopener">Get directions</a>
          <a class="btn" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <div class="frame" data-reveal style="--i:1">
        <Hours />
      </div>
    </div>
  </section>

  <ReserveBand />
</Base>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    filter: saturate(1.1) contrast(1.05) sepia(0.15);
    animation: hero-zoom 28s var(--ease) both;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(75% 55% at 50% 50%, rgba(15, 10, 8, 0.78), rgba(15, 10, 8, 0.42) 75%),
      linear-gradient(to bottom, rgba(15, 10, 8, 0.8), rgba(63, 10, 15, 0.3) 40%, var(--ink) 97%);
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.18);
    }
    to {
      transform: scale(1.02);
    }
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2rem;
  }
  .hero__inner > * {
    animation: rise 1.3s var(--ease) both;
  }
  .hero__inner > :nth-child(2) {
    animation-delay: 0.15s;
  }
  .hero__inner > :nth-child(3) {
    animation-delay: 0.4s;
  }
  .hero__inner > :nth-child(4) {
    animation-delay: 0.55s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
  }
  .hero__eyebrow {
    margin: 0 0 clamp(1.25rem, 3vw, 2.25rem);
    font-size: clamp(0.62rem, 1.1vw, 0.8rem);
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--brass-soft);
  }
  .hero__eyebrow span {
    color: var(--red);
    padding-inline: 0.6em;
  }
  .hero__tag {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    line-height: 1.2;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }
  .hero__tag em {
    color: var(--brass-soft);
  }
  .hero__cta {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    justify-content: center;
  }
  .hero__strip {
    list-style: none;
    margin: 0;
    padding: 1.1rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    background: rgba(15, 10, 8, 0.55);
    backdrop-filter: blur(6px);
  }
  .hero__strip span {
    margin-right: 0.8em;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .hero__strip a {
    text-decoration: none;
  }
  .hero__strip a:hover {
    color: var(--brass-soft);
  }

  /* ── ticker ── */
  .ticker {
    overflow: hidden;
    background: var(--red);
    color: var(--cream);
    padding-block: 0.95rem;
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: tick 48s linear infinite;
  }
  .ticker span {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.25rem;
    white-space: nowrap;
  }
  .ticker i {
    font-style: normal;
    font-size: 0.6em;
    padding-inline: 1.6em;
    vertical-align: 0.2em;
    color: var(--ink);
  }
  @keyframes tick {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── heritage ── */
  .heritage {
    overflow: hidden;
  }
  .heritage__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .heritage__year {
    position: relative;
  }
  .heritage__num {
    display: block;
    font-family: var(--display);
    font-size: clamp(6rem, 13vw, 12rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--wine);
  }
  .heritage__script {
    position: absolute;
    top: -0.95em;
    left: -0.15em;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    color: var(--red);
    transform: rotate(-8deg);
  }
  .heritage__copy .lede {
    margin-block: 1.6rem 1.2rem;
    color: var(--ink);
  }
  .heritage__copy .link {
    margin-top: 1rem;
  }
  .heritage__photo {
    position: relative;
    margin: 0;
    transform: rotate(2deg);
    box-shadow: 0 30px 60px -25px rgba(63, 10, 15, 0.6);
  }
  .heritage__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.06) sepia(0.12);
  }
  .heritage__photo::after {
    content: '';
    position: absolute;
    inset: 0.8rem;
    border: 1px solid rgba(243, 233, 214, 0.45);
  }
  .room {
    padding-bottom: calc(var(--section) * 0.6);
    overflow: hidden;
  }
  .room__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 26rem);
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ── theatre ── */
  .theatre {
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(201, 163, 93, 0.12), transparent 70%),
      var(--ink);
  }
  .theatre__head .lede {
    margin-top: 1.6rem;
  }
  .acts {
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
  }
  .act {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem) clamp(2.25rem, 4vw, 3.5rem);
    text-align: center;
    border-left: 1px solid var(--line);
    transition: background 0.6s var(--ease);
  }
  .act:first-child {
    border-left: 0;
  }
  .act:hover {
    background: rgba(201, 163, 93, 0.06);
  }
  .act__no {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--red);
  }
  .act__art {
    width: 7.5rem;
    margin: 1.75rem auto;
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.8s var(--ease);
  }
  .act:hover .act__art {
    transform: rotate(-6deg) scale(1.06);
  }
  .act__title {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-style: italic;
    margin-bottom: 0.8rem;
  }
  .act p {
    color: var(--muted);
    font-size: 1rem;
    max-width: 22em;
    margin-inline: auto;
  }

  /* ── signatures ── */
  .sig__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .sig__photo {
    position: relative;
    margin: 0;
  }
  .sig__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05);
  }
  .sig__photo::after {
    content: '';
    position: absolute;
    inset: 0.9rem;
    border: 1px solid rgba(243, 233, 214, 0.35);
    pointer-events: none;
  }
  .sig__photo figcaption {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-6deg);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    white-space: nowrap;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.8);
  }
  .sig__dishes {
    margin-block: 1.75rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  /* ── bar ── */
  .bar__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .bar__glass {
    width: 4.5rem;
    margin-bottom: 2rem;
    fill: none;
    stroke: var(--brass-soft);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-origin: 50% 100%;
    animation: sway 7s ease-in-out infinite;
  }
  @keyframes sway {
    50% {
      transform: rotate(4deg);
    }
  }
  .bar__intro .lede {
    margin-block: 1.6rem 2rem;
    color: rgba(243, 233, 214, 0.8);
  }
  .bar__card {
    background: rgba(15, 10, 8, 0.45);
  }
  .bar__card .dish:last-child {
    border-bottom: 0;
  }

  /* ── press ── */
  .press__grid {
    display: grid;
