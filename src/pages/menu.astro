---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReserveBand from '../components/ReserveBand.astro';
import { site } from '../data/site';
import { menu } from '../data/menu';
import board from '../assets/antipasti-board.jpg';
---

<Base
  title="Menus"
  description="The Taverna dinner menu: antipasti, house-made pasta, steaks and chops, whole fish, parmigiana, pizza, classic cocktails and an all-Italian wine list."
>
  <PageHero eyebrow="Eat + Drink" image={board}>
    <Fragment slot="title">The <em>Menus</em></Fragment>
    Steaks and chops, pasta made in house, whole fish, red-sauce classics and pizza for the table.
  </PageHero>

  <nav class="jump" aria-label="Menu sections">
    <div class="jump__track">
      {
        menu.map((g) => (
          <>
            <a class="jump__group" href={`#${g.id}`}>{g.title}</a>
            {g.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
          </>
        ))
      }
      <a class="jump__group" href={site.links.menuPdf} target="_blank" rel="noopener">Wine list (PDF)</a>
    </div>
  </nav>

  {
    menu.map((g, gi) => (
      <section class:list={['section', 'card-section', gi % 2 === 0 ? 'section--cream' : 'section--oxblood']} id={g.id}>
        <div class="wrap">
          <header class="center card-head" data-reveal>
            <p class="script card-head__kicker">{g.kicker}</p>
            <h2 class="display">{g.title}</h2>
          </header>

          {g.sections.map((s) => (
            <div class="course" id={s.id} data-reveal>
              <div class="course__head">
                <h3 class="course__title">{s.title}</h3>
                {s.note && <p class="course__note">{s.note}</p>}
              </div>
              <div class="course__items">
                {s.items.map((d) => (
                  <div class="dish">
                    <span class="dish__name">{d.name}</span>
                    <span class="dish__price">{d.price}</span>
                    {d.desc && <p class="dish__desc">{d.desc}</p>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="section wine">
    <div class="wrap wrap--narrow center" data-reveal>
      <p class="eyebrow eyebrow--center">La Cantina</p>
      <h2 class="title">Wine, beer &amp; <em>spirits</em></h2>
      <p class="lede">
        An all-Italian list, from Prosecco and Pinot Grigio by the glass to Barolo, Brunello, Tignanello and Sassicaia
        from the cellar. Plus Saskatoon beer on tap and a deep back bar of whisky and amaro.
      </p>
      <div class="btn-row">
        <a class="btn" href={site.links.menuPdf} target="_blank" rel="noopener">Download the full menu &amp; wine list</a>
        <a class="btn" href={site.links.order} target="_blank" rel="noopener">Order takeout</a>
      </div>
      <p class="fine">
        A 20% gratuity is added to parties of six or more. Please let your server know about allergies or time
        constraints. Vintages, prices and availability are subject to change.
      </p>
    </div>
  </section>

  <ReserveBand />
</Base>

<style>
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    background: rgba(15, 10, 8, 0.95);
    backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
  }
  .jump__track {
    display: flex;
    gap: 0.25rem;
    max-width: var(--max);
    margin-inline: auto;
    padding: 0 var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump__track::-webkit-scrollbar {
    display: none;
  }
  .jump a {
    flex: none;
    padding: 1.05rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s;
  }
  .jump a:hover {
    color: var(--cream);
  }
  .jump a.jump__group {
    color: var(--brass-soft);
  }
  .jump a.jump__group:not(:first-child) {
    margin-left: 0.75rem;
    padding-left: 1.65rem;
    border-left: 1px solid var(--line);
  }

  .card-head {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .card-head__kicker {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: -0.1em;
  }
  .section--cream .card-head__kicker {
    color: var(--red);
  }

  .course {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-top: 1px solid var(--line);
  }
  .course__head {
    position: sticky;
    top: calc(var(--header-h) + 5rem);
    align-self: start;
  }
  .course__title {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-style: italic;
  }
  .section--cream .course__title {
    color: var(--wine);
  }
  .course__note {
    margin-top: 0.6rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .course__items {
    columns: 2;
    column-gap: clamp(2rem, 4vw, 4rem);
  }

  .wine .lede {
    margin-block: 1.5rem 2.25rem;
  }
  .fine {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 62rem) {
    .course {
      grid-template-columns: 1fr;
    }
    .course__head {
      position: static;
    }
  }
  @media (max-width: 40rem) {
    .course__items {
      columns: 1;
    }
  }
</style>
