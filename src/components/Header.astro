---
import { site, nav, link } from '../data/site';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname;
const left = nav.slice(0, 3);
const right = nav.slice(3);
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="header" data-header>
  <div class="header__bar">
    <nav class="header__nav header__nav--left" aria-label="Primary">
      {left.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <a class="header__logo" href={link('/')} aria-label="Taverna — home">
      <Wordmark />
    </a>

    <nav class="header__nav header__nav--right" aria-label="Secondary">
      {right.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="btn btn--solid btn--sm" href={site.links.reserve} target="_blank" rel="noopener">Reserve</a>
    </nav>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="drawer" data-toggle>
      <span class="sr">Menu</span>
      <span class="header__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-drawer hidden>
  <nav class="drawer__nav" aria-label="Mobile">
    {
      nav.map((n, i) => (
        <a href={n.href} style={`--i:${i}`}>
          <span class="drawer__num">0{i + 1}</span>
          {n.label}
        </a>
      ))
    }
  </nav>
  <div class="drawer__actions">
    <a class="btn btn--solid" href={site.links.reserve} target="_blank" rel="noopener">Reserve a table</a>
    <a class="btn" href={site.links.order} target="_blank" rel="noopener">Order takeout</a>
  </div>
  <p class="drawer__meta">
    <a href={site.phoneHref}>{site.phone}</a><br />
    {site.address.street}, {site.address.city}
  </p>
</div>

<!-- always-on action bar for phones -->
<div class="dock" aria-label="Quick actions">
  <a href={site.links.reserve} target="_blank" rel="noopener" class="dock__main">Reserve</a>
  <a href={site.links.order} target="_blank" rel="noopener">Order</a>
  <a href={site.phoneHref}>Call</a>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;

  const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
    if (open) {
      drawer.hidden = false;
      requestAnimationFrame(() => drawer.classList.add('is-open'));
    } else {
      drawer.classList.remove('is-open');
      setTimeout(() => (drawer.hidden = true), 450);
    }
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition:
      background 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(15, 10, 8, 0.85), transparent);
    transition: opacity 0.5s;
  }
  .header.is-stuck {
    background: rgba(15, 10, 8, 0.92);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .header.is-stuck::before {
    opacity: 0;
  }
  :global(.nav-open) .header {
    background: var(--ink);
  }

  .header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
    max-width: 100rem;
    margin-inline: auto;
  }
  .header__logo {
    text-decoration: none;
    grid-column: 2;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.4rem);
  }
  .header__nav--right {
    justify-content: flex-end;
  }
  .header__nav a:not(.btn) {
    position: relative;
    padding-block: 0.5rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--cream);
  }
  .header__nav a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.26em;
    bottom: 0.15rem;
    height: 1px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .header__nav a:not(.btn):hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__toggle {
    display: none;
    grid-column: 3;
    justify-self: end;
    width: 3rem;
    height: 3rem;
    margin-right: -0.6rem;
    background: none;
    border: 0;
    color: var(--cream);
    cursor: pointer;
  }
  .header__bars {
    display: grid;
    gap: 7px;
    width: 26px;
    margin: auto;
  }
  .header__bars i {
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  [aria-expanded='true'] .header__bars i:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  [aria-expanded='true'] .header__bars i:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* drawer */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2.5rem;
    background:
      radial-gradient(100% 60% at 100% 100%, rgba(184, 40, 31, 0.3), transparent 70%),
      var(--ink);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  .drawer[hidden] {
    display: none;
  }
  .drawer.is-open {
    opacity: 1;
  }
  .drawer__nav {
    display: grid;
  }
  .drawer__nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: clamp(2rem, 9vw, 2.8rem);
    text-decoration: none;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 60ms + 100ms);
  }
  .drawer.is-open .drawer__nav a {
    opacity: 1;
    transform: none;
  }
  .drawer__num {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--brass);
  }
  .drawer__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
  }
  .drawer__meta {
    color: var(--muted);
    font-size: 0.95rem;
    text-align: center;
  }

  /* phone dock */
  .dock {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 80;
    grid-template-columns: 1.4fr 1fr 1fr;
    background: rgba(15, 10, 8, 0.96);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .dock a {
    display: grid;
    place-items: center;
    min-height: 3.5rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    border-left: 1px solid var(--line);
  }
  .dock a:first-child {
    border-left: 0;
  }
  .dock__main {
    background: var(--red);
  }

  @media (max-width: 62rem) {
    .header__nav {
      display: none;
    }
    .header__bar {
      grid-template-columns: auto 1fr auto;
    }
    .header__logo {
      grid-column: 1;
    }
    .header__toggle {
      display: block;
    }
    .dock {
      display: grid;
    }
  }
</style>
