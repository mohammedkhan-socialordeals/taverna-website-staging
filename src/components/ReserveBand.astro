---
// The closing "book a table" band used at the bottom of every page.
import { site, link } from '../data/site';
---

<section class="band section section--oxblood">
  <div class="wrap center" data-reveal>
    <p class="script band__script">Your table is waiting</p>
    <h2 class="display">Make it <em>an occasion.</em></h2>
    <p class="lede">
      Book online with OpenTable, or call us at <a href={site.phoneHref}>{site.phone}</a>. We’re a family-run room and
      everyone wears a few hats, so if we miss your call, online is quickest.
    </p>
    <div class="btn-row">
      <a class="btn btn--solid" href={site.links.reserve} target="_blank" rel="noopener">Reserve a table</a>
      <a class="btn" href={site.links.order} target="_blank" rel="noopener">Order takeout</a>
      <a class="btn" href={link('/private-dining/')}>Private dining</a>
    </div>
  </div>
</section>

<style>
  .band {
    overflow: hidden;
  }
  .band::before,
  .band::after {
    content: '';
    position: absolute;
    inset-inline: var(--gutter);
    height: 1px;
    background: var(--line);
  }
  .band::before {
    top: 1.25rem;
  }
  .band::after {
    bottom: 1.25rem;
  }
  .band__script {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin-bottom: 0.4rem;
  }
  .band .lede {
    margin-block: 1.6rem 2.4rem;
  }
  .band .btn--solid {
    --bg: var(--cream);
    --bd: var(--cream);
    --fg: var(--ink);
  }
</style>
