---
import { Image } from 'astro:assets';
interface Props {
  eyebrow: string;
  image?: ImageMetadata;
  position?: string;
}
const { eyebrow, image, position = 'center' } = Astro.props;
---

<section class="phero">
  {
    image && (
      <Image
        class="phero__img"
        src={image}
        alt=""
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position:${position}`}
      />
    )
  }
  <div class="wrap phero__inner">
    <p class="eyebrow eyebrow--center">{eyebrow}</p>
    <h1 class="display"><slot name="title" /></h1>
    <div class="lede"><slot /></div>
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(74svh, 46rem);
    padding: calc(var(--header-h) + 5rem) 0 clamp(3.5rem, 8vw, 6rem);
    text-align: center;
    background:
      radial-gradient(90% 70% at 50% 0%, rgba(184, 40, 31, 0.35), transparent 65%),
      var(--oxblood);
    overflow: hidden;
  }
  .phero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.05) sepia(0.14);
    animation: drift 24s var(--ease) both;
  }
  .phero:has(.phero__img)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--ink) 2%, rgba(15, 10, 8, 0.55) 55%, rgba(15, 10, 8, 0.8)),
      radial-gradient(circle at 50% 60%, transparent, rgba(15, 10, 8, 0.6));
  }
  @keyframes drift {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .phero__inner {
    display: grid;
    justify-items: center;
  }
  .phero .lede {
    margin-top: 1.6rem;
    color: rgba(243, 233, 214, 0.82);
  }
  .phero .lede:empty {
    display: none;
  }
</style>
