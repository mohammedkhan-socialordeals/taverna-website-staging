---
// A horizontal, swipeable strip of photographs.
// Usage: <Gallery photos={[{ src, alt, caption }]} />
import { Image } from 'astro:assets';
interface Props {
  photos: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { photos } = Astro.props;
---

<div class="gallery" data-gallery>
  <ul class="gallery__track" data-track tabindex="0" aria-label="Photographs of Taverna">
    {
      photos.map((p, i) => (
        <li class:list={['gallery__item', p.src.width > p.src.height && 'gallery__item--wide']}>
          <figure>
            <div class="gallery__frame">
              <Image src={p.src} alt={p.alt} height={900} width={Math.round((900 * p.src.width) / p.src.height)} loading="lazy" />
            </div>
            {p.caption && (
              <figcaption>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {p.caption}
              </figcaption>
            )}
          </figure>
        </li>
      ))
    }
  </ul>
  <div class="gallery__nav">
    <button type="button" data-dir="-1" aria-label="Previous photographs">←</button>
    <button type="button" data-dir="1" aria-label="More photographs">→</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const track = g.querySelector<HTMLElement>('[data-track]')!;
    g.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () =>
        track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.7, behavior: 'smooth' }),
      ),
    );
  });
</script>

<style>
  .gallery {
    position: relative;
  }
  .gallery__track {
    display: flex;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0 var(--gutter) 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }
  .gallery__item {
    flex: none;
    scroll-snap-align: start;
    height: clamp(20rem, 46vw, 36rem);
    aspect-ratio: 3 / 4;
  }
  .gallery__item--wide {
    aspect-ratio: 4 / 3;
  }
  .gallery__item:nth-child(even) {
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
  }
  figure {
    margin: 0;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .gallery__frame {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }
  .gallery__frame::after {
    content: '';
    position: absolute;
    inset: 0.7rem;
    border: 1px solid rgba(243, 233, 214, 0.3);
    pointer-events: none;
  }
  .gallery__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a warm, slightly richer grade so phone photos sit together */
    filter: saturate(1.08) contrast(1.06) brightness(0.96) sepia(0.12);
    transition: transform 1.4s var(--ease);
  }
  .gallery__item:hover img {
    transform: scale(1.05);
  }
  figcaption {
    display: flex;
    gap: 1em;
    padding-top: 0.9rem;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--muted);
  }
  figcaption span {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    color: var(--brass);
    padding-top: 0.45em;
  }
  .gallery__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1.5rem var(--gutter) 0;
  }
  .gallery__nav button {
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--brass);
    border-radius: 50%;
    background: none;
    color: inherit;
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .gallery__nav button:hover {
    background: var(--brass);
    color: var(--ink);
  }
</style>
